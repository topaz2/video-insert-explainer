{
 "_about": "Insert schedule. A string starting with = is an expression over narration anchors (<id>.s / .e / .v), N_END and the vars below; resolve_events.py turns this into events.json. Zoom targets are slide-pixel rects [x, y, w, h]; markers, bounces and blinks are 1080p screen rects of the frame they are drawn on.",
 "vars": {
  "P1": "=n0_00.e+0.35",
  "T2": "=n2_00.s-0.6",
  "R2": "=n2_02.s-0.6",
  "SHRINK": "=n9_00.s",
  "OUT": "=n9_01.e+0.16",
  "END": "=OUT+2.34+0.16",
  "TAIL": 0.25,
  "IJ1": "=n1_00.e-TAIL+0.15",
  "IJ1_DUR": 0.5
 },
