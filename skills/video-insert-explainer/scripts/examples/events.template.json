 "heading": {"text": "〜機能追加のお知らせ〜", "start": 0.3, "end": "=n0_00.e+0.2", "fade": 0.2},
 "shrink": ["=SHRINK", "=SHRINK+0.5"],
 "exit": ["=OUT", "=OUT+1.0"],
 "sfx": [
  {"file": "sfx/chime_up.wav", "gain_db": -6, "times": [0.0]},
  {"file": "sfx/flip.wav", "gain_db": -2, "times": ["=n0_00.e", "=T2"]},
