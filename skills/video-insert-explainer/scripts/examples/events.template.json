 "badges": [{"slide": 2, "text": "12/1 リリース", "color": "#1971C2", "top": 20}],
 "notes": [{"slide": 2, "text": "設定から使えます", "color": "#E8590C", "top": 80, "start": "=n2_02.s", "end": "=n2_02.e", "fade": 0.2}],
 "pip_pos": [1500, 620],
